{
    "schema_version": 1,
    "name": "CPU Only",
    "description": "Vosk only. No GPU required.",
    "mode": "auto",
    "transcription": {
        "engines": [
            {"plugin": "vosk", "enabled": true, "model": "vosk-model-en-us-0.22", "weight": 1.0, "backbone": true}
        ]
    },
    "timing": {"strategy": "fill_only", "order": ["vosk", "interpolation"]},
    "qa": {"enabled": true, "signals": {"ensemble_disagreement": {"enabled": false}, "repetition": {"enabled": true}, "timing_anomaly": {"enabled": true}}},
    "segmentation": {"max_cpl": 42, "max_lines": 2, "max_duration_ms": 7000, "min_cue_ms": 700},
    "export": {"word_srt": true, "sentence_srt": true, "transcript_format": "txt", "transcript_timestamps": true, "tags": false}
}
