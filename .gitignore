__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
build_temp/
dist/
# Audio / media inputs & outputs
*.wav
*.mp3
*.mp4
*.mkv
*.m4a
*.srt
!examples/**/*.srt
# Golden-test fixtures and expected outputs are part of the test suite.
!tests/golden/**/*.srt
# Engine artifacts
# (Vosk and MFA scratch dirs now live in the system temp dir, but older
#  runs may have left these behind in the working directory.)
temp_vosk_chunks_*/
wordalign_vosk_*/
mfa_surgical_*/
# Local model store (tens of GB) — root only. Must stay anchored with a
# leading slash: a bare "models/" also ignores the wordalign/models/
# Python package, which the code imports.
/models/
.cache/
.wordalign/
.wordalign_cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Local build / smoke-test scratch (never published)
*.log
*.err
/HANDOFF.md
/test_*.py
/test_*.ps1
/test_*.txt
